HOST=0.0.0.0
PORT=3000
SQLITE_DB_PATH=database.sqlite

# Admin seed. SUPERADMIN_PASSWORD bo'lmasa yangi superadmin avtomatik yaratilmaydi.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=
SUPERADMIN_EMAIL=superadmin@example.local
SUPERADMIN_FULL_NAME=Super Admin

# ESMO integration
ESMO_ENABLED=false
ESMO_BASE_URL=
ESMO_USER=
ESMO_PASS=
ESMO_SYNC_MAX_PAGES=2
ESMO_RECENT_BACKFILL_PAGES=2
ESMO_REQUEST_TIMEOUT_MS=20000

# ESMO terminal configuration. Real host/API key values must stay only in local .env.
ESMO_ATX_1_HOST=
ESMO_ATX_1_API_KEY=
ESMO_ATX_1_SERIAL=
ESMO_ATX_2_HOST=
ESMO_ATX_2_API_KEY=
ESMO_ATX_2_SERIAL=
ESMO_TKM_1_HOST=
ESMO_TKM_1_API_KEY=
ESMO_TKM_1_SERIAL=
ESMO_TKM_2_HOST=
ESMO_TKM_2_API_KEY=
ESMO_TKM_2_SERIAL=
ESMO_TKM_3_HOST=
ESMO_TKM_3_API_KEY=
ESMO_TKM_3_SERIAL=
ESMO_TKM_4_HOST=
ESMO_TKM_4_API_KEY=
ESMO_TKM_4_SERIAL=

# 1C weights integration (read-only)
ONEC_WEIGHTS_ENABLED=false
ONEC_BASE_URL=
ONEC_USERNAME=
ONEC_PASSWORD=
ONEC_WEIGHT_ENTITY_SET=
ONEC_WEIGHT_TOP=1000
ONEC_TIMEOUT_MS=15000
ONEC_AUTO_SYNC_MS=5000

# AZS fuel integration (isolated, read-only)
AZS_ENABLED=false
AZS_BASE_URL=https://api.azs.garvex.tech/api
AZS_AUTH_BASE_URL=https://api.auth.garvex.tech/api
AZS_USERNAME=
AZS_PASSWORD=
AZS_TOKEN_PATH=/Authenticate/Login
AZS_EVENTS_PATH=/events/deviceRefillEvents
AZS_TIMEOUT_MS=12000
AZS_REQUEST_RETRIES=2
AZS_AUTO_SYNC_MS=60000
AZS_STALE_AFTER_MS=180000
AZS_ANOMALY_LITERS=120
AZS_FETCH_PAGE_SIZE=200
AZS_FETCH_MAX_PAGES=100
AZS_INITIAL_BACKFILL_HOURS=8760
AZS_OVERLAP_SECONDS=600
AZS_RETRY_MAX_MS=900000
AZS_HISTORY_START_DATE=
AZS_HISTORY_CHUNK_DAYS=3
AZS_HISTORY_SLEEP_MS=300

# Garvex MT tracking integration (isolated, read-only)
GARVEX_MT_ENABLED=false
GARVEX_MT_AUTH_BASE_URL=https://api.auth.garvex.tech
GARVEX_MT_API_BASE_URL=https://api.mt.garvex.tech
GARVEX_MT_LOGIN_PATH=/api/Authenticate/Login
GARVEX_MT_PERMISSION_PATH=/api/Permissions/GetSelfAccountPermission
GARVEX_MT_UNITS_PATH=/api/Units/GetUnits
GARVEX_MT_LAST_DATA_PATH=/api/Units/GetLastData
GARVEX_MT_USERNAME=
GARVEX_MT_PASSWORD=
GARVEX_MT_TIMEOUT_MS=12000
GARVEX_MT_REQUEST_RETRIES=1
GARVEX_MT_AUTO_SYNC_MS=120000
GARVEX_MT_FULL_SYNC_MS=900000
GARVEX_MT_FETCH_PAGE_SIZE=5
GARVEX_MT_FETCH_MAX_PAGES=30
GARVEX_MT_SHOW_ADDRESSES=true

# Turniket / Hikvision webhook and poller. Real IP/password values must stay only in local .env.
# JSON format:
# {"DEVICE_HOST":{"key":"kirish-1","deviceId":"IN-1","deviceName":"Kirish-1","eventType":"entrance"}}
HIKVISION_DEVICE_IP_MAP=
HIKVISION_EXTRA_DEVICE_MAP=
HIKVISION_VERIFY_MODE_ALLOWLIST=face
HIKVISION_POLLER_ENABLED=false
HIKVISION_POLLER_USERNAME=
HIKVISION_POLLER_PASSWORD=
HIKVISION_POLLER_INTERVAL_SECONDS=120
HIKVISION_POLLER_LOOKBACK_MINUTES=45
HIKVISION_POLLER_MAX_EVENTS_PER_DEVICE=200
HIKVISION_POLLER_DEVICE_PORT=80
HIKVISION_POLLER_DEVICE_IPS=
HIKVISION_POLLER_MINE_ONLY=false
HIKVISION_POLLER_IMPORT_EVENTS=false
HIKVISION_RECORD_ALL_EVENTS=false
HIKVISION_REQUIRE_MINOR_75=true
HIKVISION_MAX_EVENT_AGE_MINUTES=60
HIKVISION_CROSS_DEVICE_DEDUP_SECONDS=12
HIKVISION_MINE_FACTORY_DEDUP_SECONDS=120
